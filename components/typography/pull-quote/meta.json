    },
    {
      "name": "Bordered Pull Quote",
      "props": { "variant": "bordered" },
      "content": "Simplicity is the ultimate sophistication."
    }
  ],
  "dependencies": [],
  "relatedComponents": ["blockquote", "paragraph"]
