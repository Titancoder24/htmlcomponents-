{
  "id": "progress-circle",
  "name": "progress-circle",
  "displayName": "Progress Circle",
  "description": "Circular progress indicator using SVG with stroke-dasharray animation. Supports sizes, colors, center label, and indeterminate mode.",
  "category": "primitives",
  "version": "0.1.0",
  "status": "stable",
  "tags": ["progress", "circle", "radial", "indicator", "loading"],
  "props": {
    "value": {
      "type": "number",
      "default": 0,
      "description": "Current progress value (0-100)"
    },
    "size": {
      "type": "string",
      "default": "md",
      "options": ["sm", "md", "lg", "xl"],
      "description": "Size of the circular progress"
    },
    "color": {
      "type": "string",
      "default": "primary",
      "options": ["primary", "success", "warning", "error"],
      "description": "Color of the progress stroke"
    },
    "strokeWidth": {
      "type": "number",
      "default": 4,
      "description": "Width of the progress stroke"
    },
    "showLabel": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the percentage label in center"
    },
    "indeterminate": {
      "type": "boolean",
      "default": false,
      "description": "Whether to show indeterminate spinning animation"
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Accessible label for the progress"
    }
  },
  "slots": {
    "default": {
      "description": "Custom content to display in the center instead of percentage"
    }
  },
  "events": {},
  "accessibility": {
    "role": "progressbar",
    "keyboard": {},
    "ariaAttributes": ["aria-valuenow", "aria-valuemin", "aria-valuemax", "aria-label"]
  },
  "variants": [
    { "name": "default", "description": "Standard circular progress" },
    { "name": "indeterminate", "description": "Spinning indeterminate loader" }
  ],
  "examples": [
    {
      "title": "Progress at 75%",
      "props": { "value": 75, "size": "md", "color": "primary" }
    },
    {
      "title": "Large success circle",
      "props": { "value": 100, "size": "lg", "color": "success", "showLabel": true }
    },
    {
      "title": "Indeterminate spinner",
      "props": { "indeterminate": true, "size": "md", "color": "primary" }
    }
  ],
  "dependencies": [],
  "relatedComponents": ["progress-bar", "spinner"]
}