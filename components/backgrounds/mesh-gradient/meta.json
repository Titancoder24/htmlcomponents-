/**
 * Voltz UI - Mesh Gradient Background
 * Static mesh gradient (Apple-style)
 * @version 1.0.0
 */
{
  "name": "mesh-gradient",
  "displayName": "Mesh Gradient",
  "description": "Static mesh gradient with Apple-style aesthetic. Preset palettes with multiple blob positions using CSS radial-gradient.",
  "category": "backgrounds",
  "version": "1.0.0",
  "status": "stable",
  "author": "Voltz UI",
  "tags": ["background", "mesh", "gradient", "static", "apple-style", "css-only"],
  "variants": ["default", "aurora", "candy", "midnight", "earth", "lavender"],
  "props": {
    "variant": {
      "type": "string",
      "default": "default",
      "options": ["default", "aurora", "candy", "midnight", "earth", "lavender"],
      "description": "Mesh gradient color palette"
    },
    "opacity": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "Overall opacity"
    }
  },
  "slots": {
    "default": {
      "description": "Content to overlay on the mesh gradient"
    }
  },
  "dependencies": [],
  "accessibility": {
    "reducedMotion": "No animations - inherently accessible",
    "role": "presentation"
  }
}
