/**
 * Voltz UI - Dot Grid Background
 * Repeating dot pattern background
 * @version 1.0.0
 */
{
  "name": "dot-grid",
  "displayName": "Dot Grid",
  "description": "Repeating dot pattern background with configurable dot size, spacing, color, and opacity. CSS-only with radial-gradient.",
  "category": "backgrounds",
  "version": "1.0.0",
  "status": "stable",
  "author": "Voltz UI",
  "tags": ["background", "dots", "grid", "pattern", "css-only"],
  "variants": ["default", "dense", "sparse", "large", "accent"],
  "props": {
    "variant": {
      "type": "string",
      "default": "default",
      "options": ["default", "dense", "sparse", "large", "accent"],
      "description": "Dot grid preset"
    },
    "dotSize": {
      "type": "string",
      "default": "1px",
      "description": "Size of each dot"
    },
    "spacing": {
      "type": "string",
      "default": "24px",
      "description": "Space between dots"
    },
    "color": {
      "type": "string",
      "default": "#9ca3af",
      "description": "Dot color"
    },
    "opacity": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Dot opacity"
    }
  },
  "slots": {
    "default": {
      "description": "Content to overlay on the dot grid background"
    }
  },
  "dependencies": [],
  "accessibility": {
    "reducedMotion": "No animations - inherently accessible",
    "role": "presentation"
  }
}
