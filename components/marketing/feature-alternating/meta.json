    "--voltz-feature-alt-bg": { "default": "#0a0a0a", "description": "Background color" },
    "--voltz-feature-alt-text-color": { "default": "#ffffff", "description": "Title color" },
    "--voltz-feature-alt-desc-color": { "default": "#888", "description": "Description color" },
    "--voltz-feature-alt-accent": { "default": "#6366f1", "description": "Accent color" },
    "--voltz-feature-alt-gap": { "default": "4rem", "description": "Gap between columns" }
  },
  "responsive": { "min": "320px", "max": "2560px" },
  "darkMode": true
